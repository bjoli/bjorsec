;; tests/docs.bjo
;;
;; Every example in src/core.bjodoc and docs/index.sz, run, with the answer
;; its comment gives. An example that changes changes here too.

(import (bjorsec core))
(import (std simpletest))

(: value (-> (Parser %a) string %a))
(defun (value p text)
  (match (run-parser p text)
    ((Ok v) v)
    ((Err e) (panic! (error->string e)))))

(: message (-> (Parser %a) string string))
(defun (message p text)
  (match (run-parser/message p text)
    ((Ok _) "it parsed")
    ((Err m) m)))

(: says? (-> (Parser %a) string string bool))
(defun (says? p text what) (string-contains? (message p text) what))

;; The module's example.
(: ints (Parser (List int)))
(def ints
  (between (pchar #\[) (pchar #\])
           (sep-by (pleft pint spaces) (pleft (pchar #\,) spaces))))

(: answer (Parser string))
(def answer (por (pstring "yes") (pstring "no")))

(: a-then-b (Parser string))
(def a-then-b (pright (pchar #\a) (pstring "b")))

(: minus (Parser (-> int int int)))
(def minus (pright (pchar #\-) (preturn -)))

(type (: Nested (Union (: Num int) (: Nest (List Nested)))))

(: value-ref (ParserRef Nested))
(def value-ref (pforward))
(: nested-value (Parser Nested))
(def nested-value (pforwarded value-ref))
(: nested (Parser Nested))
(def nested
  (pmap Nest (between (pchar #\[) (pchar #\]) (sep-by nested-value (pleft (pchar #\,) spaces)))))

(: depth (-> Nested int))
(defun (depth n)
  (match n
    ((Num _) 0)
    ((Nest xs) (+ 1 (loop (:for x xs) (:acc m (folding 0 (max m (depth x)))) => m)))))

(: expr (-> (Parser int)))
(defun (expr)
  (por pint (plazy (fun () (between (pchar #\() (pchar #\)) (expr))))))

;; The guide's.
(: token (-> (Parser %a) (Parser %a)))
(defun (token p) (pleft p spaces))

(: op (-> char (-> double double double) (Parser (-> double double double))))
(defun (op c f) (pright (token (pchar c)) (preturn f)))

(: calc-ref (ParserRef double))
(def calc-ref (pforward))

(def factor (por (token pdouble)
                 (between (token (pchar #\()) (token (pchar #\))) (pforwarded calc-ref))))
(def term (chainl1 factor (por (op #\* *) (op #\/ /))))
(def sum (chainl1 term (por (op #\+ +) (op #\- -))))
(def calculator (pright spaces (pleft sum eof)))

(defun (main)
  (pforward-set! value-ref (por (pmap Num pint) nested))
  (pforward-set! calc-ref sum)

  ;; The guide.
  (expect "a first parser" (value (pchar #\a) "abc") #\a)
  (expect "the end"
          (message (pleft pint eof) "42abc")
          "Parse error at line 1, column 3:\n42abc\n  ^\nExpecting: end of input\nUnexpected: 'a'")
  (expect "a token" (value (many (token pint)) "1 2 3") (list 1 2 3))
  (expect "sep-by tokens" (value (sep-by pint (token (pchar #\,))) "1, 2, 3") (list 1 2 3))
  (expect "many-fold tokens" (value (many-fold + 0 (token pint)) "1 2 3") 6)
  (expect "a name"
          (message (plabel (many-satisfy1 char-alphabetic? "a letter") "a name") "42")
          "Parse error at line 1, column 1:\n42\n^\nExpecting: a name\nUnexpected: '4'")
  (expect "the calculator" (value calculator "2 * (3 + 4)") 14.0)
  (expect "the calculator refuses"
          (message calculator "2 * (3 + 4")
          "Parse error at line 1, column 11:\n2 * (3 + 4\n          ^\nExpecting: ')'\nUnexpected: end of input")

  ;; The module.
  (expect "ints" (value ints "[1, 2, 3]") (list 1 2 3))
  (expect "ints refused"
          (message ints "[1, x]")
          "Parse error at line 1, column 5:\n[1, x]\n    ^\nExpecting: an integer\nUnexpected: 'x'")

  ;; Running.
  (expect "run-parser" (value pint "42") 42)
  (expect "the rest is not looked at" (value pint "42abc") 42)
  (expect-true "eof insists" (says? (pleft pint eof) "42abc" "Expecting: end of input"))
  (expect "run-parser/message"
          (message (pstring "yes") "no")
          "Parse error at line 1, column 1:\nno\n^\nExpecting: 'yes'\nUnexpected: 'n'")
  (expect "error->string"
          (message (por (pstring "yes") (pstring "no")) "maybe")
          "Parse error at line 1, column 1:\nmaybe\n^\nExpecting: 'yes' or 'no'\nUnexpected: 'm'")
  (match (run-parser (pright (pstring "ab\n") pint) "ab\nx")
    ((Err e)
     (expect "parse-error-position line" (struct-ref (parse-error-position e) line) 2)
     (expect "parse-error-position column" (struct-ref (parse-error-position e) column) 1))
    ((Ok _) (fail "parse-error-position")))
  (def st (make-state "12 34"))
  (expect "a parser called by hand" (match (pint st) ((Ok n) n) ((Err _) -1)) 12)
  (expect "state-position" (struct-ref (state-position st) column) 3)

  ;; Building blocks.
  (expect "preturn" (value (preturn 7) "anything") 7)
  (def byte (pbind pint (fun (n) (if (< n 256) (preturn n) (pfail "a byte is at most 255")))))
  (expect "pfail lets through" (value byte "200") 200)
  (expect-true "pfail says" (says? byte "300" "a byte is at most 255"))
  (expect "pbind" (value (pbind pint (fun (n) (prepeat n letter))) "3abc") (list #\a #\b #\c))
  (expect "pmap" (value (pmap string-length (many-satisfy char-alphabetic?)) "hello!") 5)
  (expect "pright" (value (pright (pchar #\$) pint) "$42") 42)
  (expect "pleft" (value (pleft pint (pchar #\%)) "42%") 42)
  (expect "pboth" (value (pboth letter digit) "a1") (Tuple #\a #\1))
  (expect "ppipe2" (value (ppipe2 pint (pright (pchar #\x) pint) *) "6x7") 42)
  (expect "ppipe3"
          (value (ppipe3 pint (pright (pchar #\-) pint) (pright (pchar #\-) pint)
                         (fun (y m d) (Tuple y m d)))
                 "2026-10-05")
          (Tuple 2026 10 5))
  (expect "psequence" (value (psequence (list digit letter digit)) "1a2") (list #\1 #\a #\2))

  ;; Choice.
  (expect "por" (value answer "no") "no")
  (expect-true "por merges" (says? answer "maybe" "Expecting: 'yes' or 'no'"))
  (expect-true "choice"
               (says? (choice (list (pstring "red") (pstring "green") (pstring "blue"))) "pink"
                      "Expecting: 'red', 'green' or 'blue'"))
  (expect-true "without attempt" (says? (por a-then-b (pstring "ac")) "ac" "Expecting: 'b'"))
  (expect "with attempt" (value (por (attempt a-then-b) (pstring "ac")) "ac") "ac")
  (expect "look-ahead"
          (value (pboth (look-ahead letter) (many-satisfy char-alphabetic?)) "abc")
          (Tuple #\a "abc"))
  (expect "followed-by" (value (pleft pint (followed-by (pchar #\;) "';'")) "42;") 42)
  (expect-true "followed-by refuses" (says? (pleft pint (followed-by (pchar #\;) "';'")) "42," "Expecting: ';'"))
  (def keyword-if (pleft (pstring "if") (not-followed-by alphanumeric "a longer name")))
  (expect "not-followed-by" (value keyword-if "if (x)") "if")
  (expect-true "not-followed-by refuses" (says? keyword-if "iffy" "Unexpected: a longer name"))
  (expect-true "plabel" (says? (plabel (many-satisfy1 char-alphabetic? "a letter") "a name") "42" "Expecting: a name"))
  (expect "pposition"
          (list-map (fun (t) (match t ((Tuple p _) (struct-ref p column))))
                    (value (many (pleft (pboth pposition (many-satisfy1 char-alphabetic? "a word")) spaces))
                           "ab cd"))
          (list 1 4))

  ;; Characters and strings.
  (expect "satisfy" (value (satisfy char-upper-case? "a capital") "Bob") #\B)
  (expect "pchar" (value (pchar #\x) "xyz") #\x)
  (expect "pchar/ci" (value (pchar/ci #\x) "XYZ") #\X)
  (expect "any-of" (value (any-of "+-*/") "*2") #\*)
  (expect "none-of" (value (between (pchar #\") (pchar #\") (many-chars (none-of "\""))) "\"hi\"") "hi")
  (expect "pstring gives back" (value (por (pstring "foo") (pstring "far")) "far") "far")
  (expect "pstring/ci" (value (pstring/ci "select") "SELECT *") "SELECT")
  (expect "many-satisfy" (value (many-satisfy char-numeric?) "2026-10") "2026")
  (expect "many-satisfy/slice"
          (value (many (pleft (many-satisfy/slice #(not (char=? &1 #\newline))) pnewline)) "a\nbc\n")
          (list "a" "bc"))
  (expect "many-chars"
          (value (many-chars (por (pright (pchar #\\) any-char) (none-of "\"\\"))) "a\\\"b\"")
          "a\"b")
  (expect "spaces" (value (pleft pint spaces) "7   ") 7)
  (expect "eof" (value (pleft pint eof) "42") 42)
  (expect-true "eof refuses" (says? (pleft pint eof) "42x" "Expecting: end of input"))

  ;; Repetition.
  (expect "many" (value (many (pleft pint spaces)) "1 2 3") (list 1 2 3))
  (expect "many-fold" (value (many-fold + 0 (pleft pint spaces)) "1 2 3") 6)
  (expect "many-till" (value (pmap list->string (pright (pstring "/*") (many-till any-char (pstring "*/")))) "/* hi */") " hi ")
  (expect "prepeat" (value (prepeat 3 digit) "12345") (list #\1 #\2 #\3))
  (expect "sep-by" (value (sep-by pint (pchar #\,)) "1,2,3") (list 1 2 3))
  (expect "sep-by of nothing" (value (sep-by pint (pchar #\,)) "") Nil)
  (expect "sep-end-by" (value (sep-end-by pint (pchar #\;)) "1;2;") (list 1 2))
  (expect "between" (value (between (pchar #\() (pchar #\)) pint) "(42)") 42)
  (expect "opt" (value (opt (pchar #\-)) "5") None)
  (expect "opt-or" (value (opt-or pint 1) "x") 1)
  (expect "chainl1" (value (chainl1 pint minus) "10-3-2") 5)
  (expect "chainr1" (value (chainr1 pint minus) "10-3-2") 9)

  ;; Numbers.
  (expect "pint" (value pint "-17 apples") -17)
  (expect "pdouble" (value pdouble "6.02e23") 6.02e23)
  (expect "pdouble leaves the point" (value (pboth pdouble (many-satisfy #(not (char=? &1 #\space)))) "1.x") (Tuple 1.0 ".x"))

  ;; Recursion.
  (expect "pforward" (depth (value nested "[1, [2, 3]]")) 2)
  (expect "plazy" (value (expr) "((7))") 7)

  (println "docs ok")
  0)
